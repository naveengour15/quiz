    "item": [
        {
            "name": "1. Send OTP",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Accept", "value": "application/json" },
                    { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"mobile\": \"9876543210\"\n}"
                },
                "url": {
                    "raw": "{{base_url}}/auth/send-otp",
                    "host": ["{{base_url}}"],
                    "path": ["auth", "send-otp"]
                },
                "description": "Generate and send 4-digit OTP via WhatsApp to mobile number."
            }
        },
        {
            "name": "2. Verify OTP",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Accept", "value": "application/json" },
                    { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"mobile\": \"9876543210\",\n    \"otp\": \"1234\"\n}"
                },
                "url": {
                    "raw": "{{base_url}}/auth/verify-otp",
                    "host": ["{{base_url}}"],
                    "path": ["auth", "verify-otp"]
                },
                "description": "Verify 4-digit OTP and obtain bearer session token."
            }
        },
        {
            "name": "3. Home Dashboard Data",
            "request": {
                "method": "GET",
                "header": [
                    { "key": "Accept", "value": "application/json" },
